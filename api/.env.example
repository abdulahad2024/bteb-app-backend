# Copy this file to .env and replace every placeholder before starting the API.
# Get the connection string from MongoDB Atlas -> Connect -> Drivers.
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
PORT=3000
NODE_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
PYTHON_BIN=python3
